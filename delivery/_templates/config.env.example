# ============================================================
# studio-erp 运行配置
# 用法：把本文件复制为 config.env，按实际环境修改后保存。
# 注意：
#   1. 本文件含数据库密码，不要提交到 Git，也不要发到群里。
#   2. 密码请不要包含 & ^ % " 这几个字符（Windows 批处理会解析失败），
#      如必须使用，请改为纯字母数字或先改库密码。
#   3. 等号两边不要加空格。
# ============================================================

# ---- 数据库（必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studio_erp
DB_USER=studio
DB_PASSWORD=这里填数据库密码

# ---- 服务端口（可选，默认 8080）----
SERVER_PORT=8080

# ---- 首次启动创建管理员用的初始密码（可选）----
# 只在数据库里没有任何管理员时生效；留空则不自动建号（更安全）。
# 建号后请立即用该账号登录并改密。
ADMIN_INIT_PASSWORD=

# ---- 收款计划口径（可选）----
# 订金占比（%），其余为尾款；默认 30
RECEIVABLE_DEPOSIT_PERCENT=30
# 月末催收窗口（每月最后 N 天），默认 3
RECEIVABLE_WINDOW_DAYS=3

# ---- 工资阶梯算法（可选）----
# WHOLE=跳点（默认，符合"做到 2 万拿 45%"的口径）；MARGINAL=累进
SALARY_TIER_MODE=WHOLE
